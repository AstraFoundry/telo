{
  "name": "telo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram desktop client with a workspace-aware agent.",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron && electron-rebuild -f -w tdl",
    "dev": "install-electron && node scripts/dev.mjs",
    "build": "electron-vite build",
    "package": "pnpm build && node scripts/stage-tdlib-native.mjs && electron-builder --dir",
    "release": "pnpm build && node scripts/stage-tdlib-native.mjs && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e": "electron-vite build --mode e2e && playwright test",
    "test:live": "electron-vite build && playwright test -c tests/live/playwright.config.ts",
    "telegram:check": "node scripts/check-telegram-capabilities.mjs",
    "tdlib:smoke": "node scripts/tdlib-smoke.mjs",
    "docs:check": "markdownlint-cli2 'README*.md' 'docs/**/*.md'",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm telegram:check && pnpm docs:check && pnpm test:e2e"
  },
  "build": {
    "appId": "dev.telo.desktop",
    "productName": "Telo",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/tdl/**",
      "**/node_modules/prebuilt-tdlib/**",
      "**/node_modules/@prebuilt-tdlib/**",
      "**/node_modules/.pnpm/tdl@*/**",
      "**/node_modules/.pnpm/prebuilt-tdlib@*/**",
      "**/node_modules/.pnpm/debug@*/**",
      "**/node_modules/.pnpm/ms@*/**",
      "**/node_modules/.pnpm/node-gyp-build@*/**",
      "**/node_modules/.pnpm/node-addon-api@*/**"
    ],
    "npmRebuild": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/tdlib-native",
        "to": "tdlib-native"
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/tdl/**",
      "node_modules/prebuilt-tdlib/**",
      "node_modules/@prebuilt-tdlib/**",
      "node_modules/.pnpm/tdl@*/**",
      "node_modules/.pnpm/prebuilt-tdlib@*/**",
      "node_modules/.pnpm/debug@*/**",
      "node_modules/.pnpm/ms@*/**",
      "node_modules/.pnpm/node-gyp-build@*/**",
      "node_modules/.pnpm/node-addon-api@*/**"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@ag-ui/core": "^0.0.59",
    "@ag-ui/encoder": "^0.0.59",
    "@ai-sdk/anthropic": "^4.0.48",
    "@ai-sdk/deepseek": "^3.0.39",
    "@ai-sdk/google": "^4.0.62",
    "@ai-sdk/groq": "^4.0.37",
    "@ai-sdk/mistral": "^4.0.39",
    "@ai-sdk/openai": "^4.0.50",
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@ai-sdk/xai": "^4.0.53",
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prebuilt-tdlib/types": "0.1008067.0",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "ai": "^7.0.83",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.12",
    "lottie-web": "^5.13.0",
    "motion": "^13.1.1",
    "prebuilt-tdlib": "0.1008067.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "streamdown": "2.6.0",
    "tailwind-merge": "^3.6.0",
    "tdl": "8.1.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
