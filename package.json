{
  "name": "telo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram desktop client with a workspace-aware agent.",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder --dir",
    "release": "pnpm build && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e": "electron-vite build --mode e2e && playwright test",
    "docs:check": "markdownlint-cli2 'README*.md' 'docs/**/*.md'",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm test:e2e"
  },
  "build": {
    "appId": "dev.telo.desktop",
    "productName": "Telo",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@ag-ui/core": "^0.0.59",
    "@ag-ui/encoder": "^0.0.59",
    "@ai-sdk/openai": "^4.0.50",
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "ai": "^7.0.83",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.12",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "teleproto": "^1.229.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
